kubectl run test-denied1 --rm -i -t --image=alpine --labels role=front-end -- sh -c 'wget -qO- --timeout=2 http://admin-back-end-api-app 
echo "Проверка НЕдоступности из admin-front-end к back-end-api (должен быть таймаут):"
kubectl run test-denied2 --rm -i -t --image=alpine --labels role=admin-front-end -- sh -c 'wget -qO- --timeout=2 http://back-end-api-app 
